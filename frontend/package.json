{
	"name": "frontend",
	"version": "1.0.0",
	"description": "Frontend for FlexiGPT",
	"type": "module",
	"private": true,
	"scripts": {
		"typegen": "react-router typegen",
		"tsc": "tsc --noEmit --diagnostics",
		"typecheck": "pnpm run typegen && pnpm run tsc",
		"lint:knip": "knip --tags=-lintignore",
		"lint:knip:fix": "knip --tags=-lintignore --fix",
		"lint:oxlint": "oxlint .",
		"lint:oxlint:fix": "oxlint --fix .",
		"lint:oxlint:fixspecific": "oxlint --fix -A all -D import/consistent-type-specifier-style .",
		"lint:oxlint:fixdanger": "oxlint --fix-dangerously -A all -D typescript/consistent-type-definitions .",
		"lint": "pnpm run typegen && pnpm run lint:oxlint && pnpm run lint:knip && pnpm run fmt",
		"lint:fix": "pnpm run lint:oxlint:fix && pnpm run fmt:fix",
		"fmt": "prettier -c . --ignore-path ../.prettierignore",
		"fmt:fix": "prettier -w . --ignore-path ../.prettierignore",
		"clean": "rimraf ./dist",
		"run:wailsdev": "cross-env VITE_PLATFORM=wails react-router dev --mode dev",
		"build:pre": "pnpm run typecheck",
		"build:wails": "pnpm run clean && pnpm run build:pre && cross-env VITE_PLATFORM=wails react-router build --mode prod",
		"build:wails:licenses": "pnpm run clean && pnpm run build:pre && cross-env GEN_LICENSES=true VITE_PLATFORM=wails react-router build --mode prod",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"licenses:gen": "pnpm run build:wails:licenses"
	},
	"keywords": [],
	"author": "ppipada",
	"dependencies": {
		"@ariakit/react": "^0.4.42",
		"@fontsource-variable/inter": "^5.3.0",
		"@platejs/basic-nodes": "^53.0.0",
		"@platejs/basic-styles": "^53.0.0",
		"@platejs/floating": "^53.0.0",
		"@platejs/indent": "^53.0.0",
		"@platejs/list": "^53.3.13",
		"@platejs/tabbable": "^53.0.0",
		"@react-router/node": "^8.5.0",
		"@udecode/cn": "^52.3.4",
		"@wailsio/runtime": "3.0.0-beta.34",
		"class-variance-authority": "^0.7.1",
		"compromise": "^14.19.0",
		"isbot": "^5.2.2",
		"katex": "^0.19.0",
		"mermaid": "^12.2.0",
		"platejs": "^53.3.18",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"react-router": "^8.5.0",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"remark-gemoji": "^8.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-supersub": "^1.0.0",
		"shiki": "^4.5.0",
		"sprintf-js": "^1.1.3",
		"stopword": "^3.1.5",
		"unified": "^11.0.5",
		"uuid": "^14.0.3"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@react-router/dev": "^8.5.0",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "24.1.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/sprintf-js": "^1.1.4",
		"@types/stopword": "^2.0.3",
		"@vitejs/plugin-rsc": "^0.5.38",
		"@vitest/coverage-v8": "^5.0.5",
		"cross-env": "^10.1.0",
		"daisyui": "^5.7.50",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
		"jiti": "^2.7.0",
		"jsdom": "^30.1.3",
		"knip": "^6.42.1",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2004",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rimraf": "^6.1.3",
		"rollup-plugin-license": "^3.7.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"prettier": {
		"arrowParens": "avoid",
		"bracketSpacing": true,
		"jsxSingleQuote": false,
		"printWidth": 120,
		"proseWrap": "preserve",
		"quoteProps": "as-needed",
		"requirePragma": false,
		"semi": true,
		"singleQuote": true,
		"trailingComma": "es5",
		"plugins": [
			"@ianvs/prettier-plugin-sort-imports",
			"prettier-plugin-tailwindcss"
		],
		"importOrder": [
			"<BUILTIN_MODULES>",
			"",
			"<TYPES>^(react|react-dom|react-icons)",
			"^react$",
			"^react-dom$",
			"^react-icons/(.*)$",
			"",
			"<TYPES>^@?[a-zA-Z]",
			"<THIRD_PARTY_MODULES>",
			"",
			"<TYPES>^@/spec/(.*)$",
			"^@/spec/(.*)$",
			"",
			"<TYPES>^@/lib/(.*)$",
			"^@/lib/(.*)$",
			"",
			"<TYPES>^@/hooks/(.*)$",
			"^@/hooks/(.*)$",
			"",
			"<TYPES>^@/apis/(.*)$",
			"^@/apis/(.*)$",
			"",
			"<TYPES>^@/components/(.*)$",
			"^@/components/(.*)$",
			"",
			"<TYPES>^@/(.*)$",
			"^@/(.*)$",
			"",
			"<TYPES>^[./]",
			"^[./]"
		],
		"importOrderTypeScriptVersion": "5.0.0"
	},
	"knip": {
		"entry": [
			"vite.config.{js,cjs,mjs,ts}",
			"react-router.config.{js,cjs,mjs,ts}",
			"app/hooks/highlight_worker.ts"
		],
		"exclude": [
			"enumMembers"
		],
		"ignore": [
			"app/apis/wailsbinding/**",
			"app/lib/**",
			"app/spec/model.ts"
		],
		"ignoreBinaries": [],
		"ignoreDependencies": [
			"@testing-library/react",
			"@testing-library/user-event",
			"@tailwindcss/node"
		]
	}
}
