{
	"name": "flexigpt",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/flexigpt/flexigpt-app.git"
	},
	"author": "Pankaj Pipada <ppipada@gmail.com>",
	"description": "FlexiGPT - An AI application platform",
	"engines": {
		"node": "24.14.0"
	},
	"scripts": {
		"typecheck:build": "tsc --project ./build/tsconfig.json",
		"test:e2e": "node ./e2e/run.ts",
		"test:e2e:headed": "node ./e2e/run.ts --headed",
		"comment1": "Keep application data even after success: FLEXIGPT_E2E_KEEP_DATA=1 pnpm run test:e2e",
		"test:e2e:linux": "xvfb-run -a node ./e2e/run.ts",
		"test:e2e:report": "playwright show-report ./.e2e-artifacts/playwright-report",
		"typecheck:e2e": "tsc --project ./e2e/tsconfig.json",
		"lint:e2e": "oxlint --type-aware --config ./e2e/oxlint.config.ts ./e2e"
	},
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/node": "24.1.0",
		"browserslist": "^4.29.4",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"typescript": "^7.0.2",
		"yaml": "^2.9.1"
	}
}
