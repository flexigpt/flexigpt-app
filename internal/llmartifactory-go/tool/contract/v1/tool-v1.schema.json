{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.flexigpt.site/artifact/tool/v1.json",
	"title": "FlexiGPT Tool v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"type",
		"name",
		"version",
		"autoExecute",
		"inputSchema",
		"implementation"
	],
	"properties": {
		"type": { "const": "tool" },
		"name": { "$ref": "#/$defs/name" },
		"version": { "$ref": "#/$defs/version" },
		"displayName": { "$ref": "#/$defs/displayName" },
		"description": { "$ref": "#/$defs/description" },
		"labels": { "$ref": "#/$defs/labels" },
		"metadata": { "$ref": "#/$defs/metadata" },
		"tags": {
			"type": "array",
			"maxItems": 4096,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 256
			}
		},
		"autoExecute": {
			"type": "boolean"
		},
		"inputSchema": {
			"$ref": "#/$defs/jsonSchema"
		},
		"userArgSchema": {
			"$ref": "#/$defs/jsonSchema"
		},
		"outputSchema": {
			"$ref": "#/$defs/jsonSchema"
		},
		"implementation": {
			"$ref": "#/$defs/implementation"
		}
	},
	"$defs": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"version": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"displayName": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"description": {
			"type": "string",
			"maxLength": 16384
		},
		"labels": {
			"type": "object",
			"maxProperties": 64,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"metadata": {
			"type": "object",
			"maxProperties": 64,
			"propertyNames": {
				"not": {
					"const": "flexigpt.site/mcp-runtime-v1"
				}
			},
			"additionalProperties": true
		},
		"jsonSchema": {
			"oneOf": [
				{
					"type": "object"
				},
				{
					"type": "boolean"
				}
			]
		},
		"implementation": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "function"],
					"properties": {
						"kind": {
							"const": "go"
						},
						"function": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "sdkType", "sdkToolType"],
					"properties": {
						"kind": {
							"const": "sdk"
						},
						"sdkType": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						},
						"sdkToolType": {
							"enum": ["function", "custom", "webSearch"]
						}
					}
				}
			]
		}
	}
}
