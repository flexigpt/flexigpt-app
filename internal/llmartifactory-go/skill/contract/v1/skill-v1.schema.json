{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.flexigpt.site/artifact/skill/v1.json",
	"title": "FlexiGPT Skill v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["type", "name", "locator"],
	"properties": {
		"type": { "const": "skill" },
		"name": { "$ref": "#/$defs/name" },
		"displayName": { "$ref": "#/$defs/displayName" },
		"description": { "$ref": "#/$defs/description" },
		"labels": { "$ref": "#/$defs/labels" },
		"locator": { "$ref": "#/$defs/locator" },
		"metadata": { "$ref": "#/$defs/metadata" },
		"license": {
			"type": "string",
			"minLength": 1,
			"maxLength": 16384
		},
		"insert": {
			"enum": ["instructions", "user-message"]
		},
		"allowedTools": {
			"type": "array",
			"maxItems": 4096,
			"items": { "$ref": "#/$defs/toolMember" }
		}
	},
	"$defs": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"displayName": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"description": {
			"type": "string",
			"maxLength": 16384
		},
		"labels": {
			"type": "object",
			"maxProperties": 64,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"metadata": {
			"type": "object",
			"maxProperties": 64,
			"propertyNames": {
				"not": {
					"const": "flexigpt.site/mcp-runtime-v1"
				}
			},
			"additionalProperties": true
		},
		"locator": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 16384
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "path"],
					"properties": {
						"kind": { "const": "path" },
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "url"],
					"properties": {
						"kind": { "const": "url" },
						"url": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"integrity": {
							"type": "string",
							"pattern": "^sha256:[a-f0-9]{64}$"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "repository"],
					"properties": {
						"kind": { "const": "git" },
						"repository": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"revision": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "manager", "package"],
					"properties": {
						"kind": { "const": "package" },
						"manager": {
							"enum": ["npm", "pypi", "cargo", "go", "maven", "nuget", "oci"]
						},
						"package": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						},
						"version": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"registry": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "command"],
					"properties": {
						"kind": { "const": "command" },
						"command": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				}
			]
		},
		"patterns": {
			"type": "array",
			"maxItems": 4096,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 4096
			}
		},
		"jsonSchema": {
			"oneOf": [{ "type": "object" }, { "type": "boolean" }]
		},
		"stringMap": {
			"type": "object",
			"maxProperties": 4096,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"implementation": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "function"],
					"properties": {
						"kind": { "const": "go" },
						"function": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "provider", "operation"],
					"properties": {
						"kind": { "const": "sdk" },
						"provider": { "$ref": "#/$defs/name" },
						"operation": { "$ref": "#/$defs/name" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "command"],
					"properties": {
						"kind": { "const": "command" },
						"command": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						},
						"args": {
							"type": "array",
							"maxItems": 4096,
							"items": {
								"type": "string",
								"maxLength": 16384
							}
						},
						"env": { "$ref": "#/$defs/stringMap" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "request", "response"],
					"properties": {
						"kind": { "const": "http" },
						"request": {
							"type": "object",
							"additionalProperties": false,
							"required": ["method", "urlTemplate"],
							"properties": {
								"method": {
									"type": "string",
									"minLength": 1,
									"maxLength": 32
								},
								"urlTemplate": {
									"type": "string",
									"minLength": 1,
									"maxLength": 16384
								},
								"headers": { "$ref": "#/$defs/stringMap" },
								"bodyTemplate": {
									"type": "string",
									"maxLength": 4194304
								}
							}
						},
						"response": {
							"type": "object",
							"additionalProperties": false,
							"required": ["successCodes", "bodyOutputMode"],
							"properties": {
								"successCodes": {
									"type": "array",
									"minItems": 1,
									"items": {
										"type": "integer",
										"minimum": 100,
										"maximum": 599
									}
								},
								"bodyOutputMode": {
									"enum": ["json", "text", "bytes"]
								}
							}
						}
					}
				}
			]
		},
		"toolParameters": {
			"type": "object",
			"additionalProperties": true
		},
		"toolMember": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "name"],
					"properties": {
						"type": { "const": "tool" },
						"name": { "$ref": "#/$defs/name" },
						"locator": { "$ref": "#/$defs/locator" },
						"scope": { "const": "builtin" }
					},
					"not": { "required": ["locator", "scope"] }
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "name", "parameters"],
					"properties": {
						"type": { "const": "tool" },
						"name": { "$ref": "#/$defs/name" },
						"locator": { "$ref": "#/$defs/locator" },
						"parameters": { "$ref": "#/$defs/toolParameters" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "base"],
					"properties": {
						"type": { "const": "tool" },
						"base": {
							"$ref": "#/$defs/locator"
						},
						"include": { "$ref": "#/$defs/patterns" },
						"exclude": { "$ref": "#/$defs/patterns" },
						"nameInclude": { "$ref": "#/$defs/patterns" },
						"nameExclude": { "$ref": "#/$defs/patterns" }
					}
				}
			]
		}
	}
}
