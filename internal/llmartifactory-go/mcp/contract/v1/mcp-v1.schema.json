{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.flexigpt.site/artifact/mcp/v1.json",
	"title": "FlexiGPT MCP v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["type", "name"],
	"properties": {
		"type": { "const": "mcp" },
		"name": { "$ref": "#/$defs/name" },
		"displayName": { "$ref": "#/$defs/displayName" },
		"description": { "$ref": "#/$defs/description" },
		"labels": { "$ref": "#/$defs/labels" },
		"locator": { "$ref": "#/$defs/locator" },
		"metadata": { "$ref": "#/$defs/metadata" },
		"server": { "$ref": "#/$defs/name" },
		"transport": {
			"enum": ["stdio", "streamableHTTP"]
		},
		"command": {
			"type": "string",
			"minLength": 1,
			"maxLength": 16384
		},
		"args": { "$ref": "#/$defs/stringArray" },
		"env": { "$ref": "#/$defs/stringMap" },
		"url": {
			"type": "string",
			"minLength": 1,
			"maxLength": 16384
		},
		"headers": { "$ref": "#/$defs/stringMap" },
		"include": { "$ref": "#/$defs/include" },
		"timeoutMS": {
			"type": "integer",
			"minimum": 1
		},
		"auth": { "$ref": "#/$defs/auth" },
		"install": { "$ref": "#/$defs/install" },
		"connectionProfiles": { "$ref": "#/$defs/connectionProfiles" },
		"policy": { "$ref": "#/$defs/policyReference" }
	},
	"oneOf": [
		{
			"required": ["locator"],
			"not": {
				"anyOf": [
					{ "required": ["transport"] },
					{ "required": ["command"] },
					{ "required": ["args"] },
					{ "required": ["env"] },
					{ "required": ["url"] },
					{ "required": ["headers"] },
					{ "required": ["include"] },
					{ "required": ["timeoutMS"] },
					{ "required": ["auth"] },
					{ "required": ["install"] },
					{ "required": ["connectionProfiles"] },
					{ "required": ["policy"] }
				]
			}
		},
		{
			"required": ["transport", "command"],
			"properties": {
				"transport": { "const": "stdio" }
			},
			"not": {
				"anyOf": [
					{ "required": ["locator"] },
					{ "required": ["server"] },
					{ "required": ["url"] },
					{ "required": ["headers"] }
				]
			}
		},
		{
			"required": ["transport", "url"],
			"properties": {
				"transport": { "const": "streamableHTTP" }
			},
			"not": {
				"anyOf": [
					{ "required": ["locator"] },
					{ "required": ["server"] },
					{ "required": ["command"] },
					{ "required": ["args"] },
					{ "required": ["env"] }
				]
			}
		}
	],
	"$defs": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"displayName": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"description": {
			"type": "string",
			"maxLength": 16384
		},
		"labels": {
			"type": "object",
			"maxProperties": 64,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"metadata": {
			"type": "object",
			"maxProperties": 64,
			"propertyNames": {
				"not": {
					"const": "flexigpt.site/mcp-runtime-v1"
				}
			},
			"additionalProperties": true
		},
		"locator": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 16384
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "path"],
					"properties": {
						"kind": { "const": "path" },
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "url"],
					"properties": {
						"kind": { "const": "url" },
						"url": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"integrity": {
							"type": "string",
							"pattern": "^sha256:[a-f0-9]{64}$"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "repository"],
					"properties": {
						"kind": { "const": "git" },
						"repository": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"revision": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "manager", "package"],
					"properties": {
						"kind": { "const": "package" },
						"manager": {
							"enum": ["npm", "pypi", "cargo", "go", "maven", "nuget", "oci"]
						},
						"package": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						},
						"version": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"registry": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "command"],
					"properties": {
						"kind": { "const": "command" },
						"command": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				}
			]
		},
		"stringArray": {
			"type": "array",
			"maxItems": 4096,
			"items": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"stringMap": {
			"type": "object",
			"maxProperties": 4096,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"include": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"tools": { "$ref": "#/$defs/stringArray" },
				"resources": { "$ref": "#/$defs/stringArray" },
				"prompts": { "$ref": "#/$defs/stringArray" }
			}
		},
		"auth": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode"],
			"properties": {
				"mode": {
					"enum": ["none", "apiKey", "oauth", "clientCredentials"]
				},
				"clientCredentialsInput": { "$ref": "#/$defs/name" },
				"clientIDMetadataDocumentURL": {
					"type": "string",
					"format": "uri",
					"minLength": 1,
					"maxLength": 16384
				}
			}
		},
		"installInput": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"enum": ["text", "secret", "path", "oauthClientCredentials"]
				},
				"label": { "$ref": "#/$defs/displayName" },
				"description": { "$ref": "#/$defs/description" },
				"note": { "$ref": "#/$defs/description" },
				"placeholder": {
					"type": "string",
					"minLength": 1,
					"maxLength": 16384
				},
				"required": { "type": "boolean" },
				"default": true,
				"clientSecretRequired": { "type": "boolean" }
			}
		},
		"install": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"note": { "$ref": "#/$defs/description" },
				"inputs": {
					"type": "object",
					"maxProperties": 4096,
					"additionalProperties": {
						"$ref": "#/$defs/installInput"
					}
				},
				"allowEnvironment": {
					"type": "array",
					"maxItems": 4096,
					"items": { "$ref": "#/$defs/name" }
				}
			}
		},
		"stdioProfile": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"command": {
					"type": "string",
					"minLength": 1,
					"maxLength": 16384
				},
				"args": { "$ref": "#/$defs/stringArray" },
				"env": { "$ref": "#/$defs/stringMap" },
				"removeEnv": {
					"type": "array",
					"maxItems": 4096,
					"items": { "$ref": "#/$defs/name" }
				}
			}
		},
		"httpProfile": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"url": {
					"type": "string",
					"minLength": 1,
					"maxLength": 16384
				},
				"headers": { "$ref": "#/$defs/stringMap" },
				"removeHeaders": {
					"type": "array",
					"maxItems": 4096,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 16384
					}
				}
			}
		},
		"connectionProfile": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"platforms": {
					"type": "array",
					"maxItems": 3,
					"uniqueItems": true,
					"items": {
						"enum": ["linux", "darwin", "windows"]
					}
				},
				"stdio": { "$ref": "#/$defs/stdioProfile" },
				"http": { "$ref": "#/$defs/httpProfile" }
			},
			"oneOf": [
				{
					"required": ["stdio"],
					"not": { "required": ["http"] }
				},
				{
					"required": ["http"],
					"not": { "required": ["stdio"] }
				}
			]
		},
		"connectionProfiles": {
			"type": "object",
			"maxProperties": 4096,
			"additionalProperties": {
				"$ref": "#/$defs/connectionProfile"
			}
		},
		"policyReference": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name"],
			"properties": {
				"name": { "$ref": "#/$defs/name" },
				"required": { "type": "boolean" }
			}
		}
	}
}
