{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.flexigpt.site/artifact/agent/v1.json",
	"title": "FlexiGPT Agent v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["type", "name"],
	"properties": {
		"type": { "const": "agent" },
		"name": { "$ref": "#/$defs/name" },
		"displayName": { "$ref": "#/$defs/displayName" },
		"description": { "$ref": "#/$defs/description" },
		"labels": { "$ref": "#/$defs/labels" },
		"locator": { "$ref": "#/$defs/locator" },
		"metadata": { "$ref": "#/$defs/metadata" },
		"members": {
			"type": "array",
			"maxItems": 4096,
			"items": { "$ref": "#/$defs/agentMember" }
		},
		"loop": {
			"allOf": [
				{ "$ref": "#/$defs/singleMember" },
				{
					"properties": {
						"type": { "const": "loop" }
					}
				}
			]
		},
		"workflow": {
			"allOf": [
				{ "$ref": "#/$defs/singleMember" },
				{
					"properties": {
						"type": { "const": "workflow" }
					}
				}
			]
		}
	},
	"not": { "required": ["loop", "workflow"] },
	"$defs": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"displayName": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"description": {
			"type": "string",
			"maxLength": 16384
		},
		"labels": {
			"type": "object",
			"maxProperties": 64,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"metadata": {
			"type": "object",
			"maxProperties": 64,
			"propertyNames": {
				"not": {
					"const": "flexigpt.site/mcp-runtime-v1"
				}
			},
			"additionalProperties": true
		},
		"locator": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 16384
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "path"],
					"properties": {
						"kind": { "const": "path" },
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "url"],
					"properties": {
						"kind": { "const": "url" },
						"url": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"integrity": {
							"type": "string",
							"pattern": "^sha256:[a-f0-9]{64}$"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "repository"],
					"properties": {
						"kind": { "const": "git" },
						"repository": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"revision": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "manager", "package"],
					"properties": {
						"kind": { "const": "package" },
						"manager": {
							"enum": ["npm", "pypi", "cargo", "go", "maven", "nuget", "oci"]
						},
						"package": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						},
						"version": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"registry": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "command"],
					"properties": {
						"kind": { "const": "command" },
						"command": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				}
			]
		},
		"patterns": {
			"type": "array",
			"maxItems": 4096,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 4096
			}
		},
		"parameters": {
			"type": "object",
			"additionalProperties": true
		},
		"overrides": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"autoExecute": { "type": "boolean" },
				"includeSystemPrompt": { "type": "boolean" }
			}
		},
		"use": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode"],
			"properties": {
				"mode": {
					"enum": ["available", "active", "instructions"]
				}
			}
		},
		"agentMember": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "name"],
					"properties": {
						"type": {
							"enum": [
								"text",
								"model",
								"tool",
								"skill",
								"mcp",
								"mcp.policy",
								"plugin",
								"agent"
							]
						},
						"name": { "$ref": "#/$defs/name" },
						"insert": { "enum": ["instructions", "user-message"] },
						"locator": { "$ref": "#/$defs/locator" },
						"scope": { "const": "builtin" },
						"server": { "$ref": "#/$defs/name" },
						"overrides": { "$ref": "#/$defs/overrides" },
						"use": { "$ref": "#/$defs/use" }
					},
					"allOf": [
						{
							"if": { "properties": { "type": { "const": "text" } } },
							"then": { "required": ["insert"] },
							"else": { "not": { "required": ["insert"] } }
						},
						{
							"if": { "properties": { "type": { "const": "mcp" } } },
							"then": { "dependentRequired": { "server": ["locator"] } },
							"else": { "not": { "required": ["server"] } }
						},
						{
							"if": { "properties": { "type": { "const": "model" } } },
							"then": {
								"not": {
									"anyOf": [{ "required": ["use"] }]
								},
								"properties": {
									"overrides": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"includeSystemPrompt": { "type": "boolean" }
										}
									}
								}
							}
						},
						{
							"if": { "properties": { "type": { "const": "tool" } } },
							"then": {
								"not": { "required": ["use"] },
								"properties": {
									"overrides": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"autoExecute": { "type": "boolean" }
										}
									}
								}
							}
						},
						{
							"if": { "properties": { "type": { "const": "skill" } } },
							"then": { "not": { "required": ["overrides"] } }
						},
						{
							"if": {
								"properties": {
									"type": {
										"not": { "enum": ["model", "tool", "skill"] }
									}
								}
							},
							"then": {
								"not": {
									"anyOf": [
										{ "required": ["overrides"] },
										{ "required": ["use"] }
									]
								}
							}
						}
					],
					"not": { "required": ["scope", "locator"] }
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "name", "parameters"],
					"properties": {
						"type": {
							"enum": [
								"text",
								"model",
								"tool",
								"skill",
								"mcp",
								"mcp.policy",
								"plugin",
								"agent"
							]
						},
						"name": { "$ref": "#/$defs/name" },
						"insert": { "enum": ["instructions", "user-message"] },
						"locator": { "$ref": "#/$defs/locator" },
						"parameters": { "$ref": "#/$defs/parameters" },
						"overrides": { "$ref": "#/$defs/overrides" },
						"use": { "$ref": "#/$defs/use" }
					},
					"allOf": [
						{
							"if": { "properties": { "type": { "const": "text" } } },
							"then": { "required": ["insert"] },
							"else": { "not": { "required": ["insert"] } }
						},
						{
							"if": { "properties": { "type": { "const": "model" } } },
							"then": {
								"not": { "required": ["use"] }
							}
						},
						{
							"if": { "properties": { "type": { "const": "tool" } } },
							"then": {
								"not": { "required": ["use"] }
							}
						},
						{
							"if": { "properties": { "type": { "const": "skill" } } },
							"then": {
								"not": { "required": ["overrides"] }
							}
						},
						{
							"if": {
								"properties": {
									"type": {
										"not": { "enum": ["model", "tool", "skill"] }
									}
								}
							},
							"then": {
								"not": {
									"anyOf": [
										{ "required": ["overrides"] },
										{ "required": ["use"] }
									]
								}
							}
						}
					]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "base"],
					"properties": {
						"type": {
							"enum": [
								"model",
								"tool",
								"skill",
								"mcp",
								"mcp.policy",
								"plugin",
								"agent"
							]
						},
						"base": {
							"$ref": "#/$defs/locator"
						},
						"include": { "$ref": "#/$defs/patterns" },
						"exclude": { "$ref": "#/$defs/patterns" },
						"nameInclude": { "$ref": "#/$defs/patterns" },
						"nameExclude": { "$ref": "#/$defs/patterns" },
						"overrides": { "$ref": "#/$defs/overrides" },
						"use": { "$ref": "#/$defs/use" }
					},
					"allOf": [
						{
							"if": { "properties": { "type": { "const": "model" } } },
							"then": {
								"not": { "required": ["use"] }
							}
						},
						{
							"if": { "properties": { "type": { "const": "tool" } } },
							"then": {
								"not": { "required": ["use"] }
							}
						},
						{
							"if": { "properties": { "type": { "const": "skill" } } },
							"then": {
								"not": { "required": ["overrides"] }
							}
						},
						{
							"if": {
								"properties": {
									"type": {
										"not": { "enum": ["model", "tool", "skill"] }
									}
								}
							},
							"then": {
								"not": {
									"anyOf": [
										{ "required": ["overrides"] },
										{ "required": ["use"] }
									]
								}
							}
						}
					]
				}
			]
		},
		"singleMember": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "name"],
					"properties": {
						"type": { "enum": ["loop", "workflow"] },
						"name": { "$ref": "#/$defs/name" },
						"locator": { "$ref": "#/$defs/locator" },
						"scope": { "const": "builtin" }
					},
					"not": { "required": ["scope", "locator"] }
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "name", "parameters"],
					"properties": {
						"type": { "enum": ["loop", "workflow"] },
						"name": { "$ref": "#/$defs/name" },
						"locator": { "$ref": "#/$defs/locator" },
						"parameters": { "$ref": "#/$defs/parameters" }
					}
				}
			]
		}
	}
}
