{
	"kind": "mcp.bundle",
	"schemaID": "mcp.bundle.v1",
	"schemaVersion": "v1",
	"logicalName": "search-mcp-servers",
	"displayName": "Search MCP Servers",
	"description": "Reviewed built-in MCP definitions for documentation and web search.",
	"labels": {
		"category": "search"
	},
	"mcpServers": {
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp/oauth"
		},
		"exa": {
			"type": "http",
			"url": "https://mcp.exa.ai/mcp"
		},
		"stack-overflow": {
			"type": "http",
			"url": "https://mcp.stackoverflow.com"
		}
	},
	"bundleExtension": {
		"servers": {
			"context7": {
				"displayName": "Context7",
				"description": "Context7 documentation MCP server.",
				"auth": {
					"mode": "oauth"
				},
				"policy": {
					"ref": "safe-default",
					"required": true
				}
			},
			"exa": {
				"displayName": "Exa Search",
				"description": "Exa web and research search MCP server.",
				"auth": {
					"mode": "none"
				},
				"policy": {
					"ref": "safe-default",
					"required": true
				}
			},
			"stack-overflow": {
				"displayName": "Stack Overflow",
				"description": "Stack Overflow MCP server.",
				"auth": {
					"mode": "oauth"
				},
				"policy": {
					"ref": "safe-default",
					"required": true
				}
			}
		},
		"policies": {
			"safe-default": {
				"$schema": "https://schemas.flexigpt.dev/mcp/policy/v1.json",
				"kind": "mcp.policy",
				"schemaID": "mcp.policy.v1",
				"schemaVersion": "v1",
				"logicalName": "safe-default",
				"displayName": "Safe Default MCP Policy",
				"description": "Requires user approval for uncertain and mutating MCP operations.",
				"body": {
					"trustLevel": "trusted",
					"defaultPolicy": {
						"defaultApprovalRule": "ask",
						"defaultExecutionMode": "manual",
						"requireApprovalForUnknownRisk": true,
						"requireApprovalForWrite": true,
						"requireApprovalForDestructive": true
					},
					"toolPolicies": {},
					"appsPolicy": {
						"enabled": false,
						"allowAppInitiatedToolCalls": false,
						"requireApprovalForOpenLink": true,
						"requireApprovalForContextUpdates": true
					}
				}
			}
		}
	}
}
