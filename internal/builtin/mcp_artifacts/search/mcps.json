{
	"kind": "mcp.bundle",
	"schemaID": "mcp.bundle.v1",
	"schemaVersion": "v1",
	"logicalName": "search-mcp-servers",
	"displayName": "Search MCP Servers",
	"description": "Built-in MCP server definitions for web and document search.",
	"labels": {
		"category": "search"
	},
	"mcpServers": {
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp/oauth"
		},
		"exa": {
			"type": "http",
			"url": "https://mcp.exa.ai/mcp",
			"headers": {
				"x-api-key": "${EXA_API_KEY}"
			}
		},
		"stack-overflow": {
			"type": "http",
			"url": "https://mcp.stackoverflow.com"
		}
	},
	"bundleExtension": {
		"servers": {
			"context7": {
				"displayName": "Context7",
				"description": "Context7 documentation MCP server.",
				"auth": {
					"mode": "oauth"
				},
				"policy": {
					"ref": "context7-default",
					"required": true
				}
			},
			"exa": {
				"displayName": "Exa Search",
				"description": "Exa web and research search MCP server.",
				"auth": {
					"mode": "none"
				},
				"install": {
					"inputs": {
						"EXA_API_KEY": {
							"kind": "secret",
							"label": "Exa API Key",
							"description": "Optional Exa API key for higher limits and Agent tools.",
							"required": false
						}
					}
				},
				"policy": {
					"ref": "auto-read",
					"required": true
				}
			},
			"stack-overflow": {
				"displayName": "Stack Overflow",
				"description": "Stack Overflow MCP server.",
				"auth": {
					"mode": "oauth"
				},
				"policy": {
					"ref": "auto-read",
					"required": true
				}
			}
		},
		"policies": {
			"context7-default": {
				"kind": "mcp.policy",
				"schemaID": "mcp.policy.v1",
				"schemaVersion": "v1",
				"logicalName": "context7-default",
				"displayName": "Context7 Default Policy",
				"body": {
					"trustLevel": "trusted",
					"defaultPolicy": {
						"defaultApprovalRule": "allow",
						"defaultExecutionMode": "auto",
						"requireApprovalForUnknownRisk": false,
						"requireApprovalForWrite": true,
						"requireApprovalForDestructive": true
					},
					"toolPolicies": {},
					"appsPolicy": {
						"enabled": false,
						"allowAppInitiatedToolCalls": false,
						"requireApprovalForOpenLink": true,
						"requireApprovalForContextUpdates": true
					}
				}
			},
			"auto-read": {
				"kind": "mcp.policy",
				"schemaID": "mcp.policy.v1",
				"schemaVersion": "v1",
				"logicalName": "auto-read",
				"displayName": "Automatic Read Policy",
				"body": {
					"trustLevel": "trusted",
					"defaultPolicy": {
						"defaultApprovalRule": "allow",
						"defaultExecutionMode": "auto",
						"requireApprovalForUnknownRisk": true,
						"requireApprovalForWrite": false,
						"requireApprovalForDestructive": false
					},
					"toolPolicies": {},
					"appsPolicy": {
						"enabled": false,
						"allowAppInitiatedToolCalls": false,
						"requireApprovalForOpenLink": true,
						"requireApprovalForContextUpdates": true
					}
				}
			}
		}
	}
}
