{
	"kind": "mcp.bundle",
	"schemaID": "mcp.bundle.v1",
	"schemaVersion": "v1",
	"logicalName": "zoom-mcp-servers",
	"displayName": "Zoom MCP Servers",
	"description": "Official Zoom hosted remote MCP server definitions.",
	"mcpServers": {
		"docs": {
			"type": "http",
			"url": "https://mcp.zoom.us/mcp/docs/streamable"
		},
		"meetings": {
			"type": "http",
			"url": "https://zoom.us/mcp/meeting/streamable"
		},
		"team-chat": {
			"type": "http",
			"url": "https://mcp.zoom.us/mcp/team_chat/streamable"
		},
		"whiteboard": {
			"type": "http",
			"url": "https://mcp.zoom.us/mcp/whiteboard/streamable"
		},
		"workspace": {
			"type": "http",
			"url": "https://mcp.zoom.us/mcp/zoom/streamable"
		}
	},
	"bundleExtension": {
		"servers": {
			"docs": {
				"displayName": "Zoom Docs",
				"auth": { "mode": "oauth" },
				"policy": { "ref": "manual-write", "required": true }
			},
			"meetings": {
				"displayName": "Zoom Meetings",
				"auth": {
					"mode": "oauth",
					"clientCredentialsInput": "ZOOM_OAUTH_CLIENT"
				},
				"install": {
					"note": "Zoom requires a Marketplace OAuth client and a registered FlexiGPT redirect URI.",
					"inputs": {
						"ZOOM_OAUTH_CLIENT": {
							"kind": "oauthClientCredentials",
							"label": "Zoom OAuth Client",
							"description": "Client ID and Client Secret from a Zoom Marketplace app.",
							"required": true,
							"clientSecretRequired": true
						}
					}
				},
				"policy": { "ref": "manual-write", "required": true }
			},
			"team-chat": {
				"displayName": "Zoom Team Chat",
				"auth": { "mode": "oauth" },
				"policy": { "ref": "manual-write", "required": true }
			},
			"whiteboard": {
				"displayName": "Zoom Whiteboard",
				"auth": { "mode": "oauth" },
				"policy": { "ref": "manual-write", "required": true }
			},
			"workspace": {
				"displayName": "Zoom Workspace",
				"auth": { "mode": "oauth" },
				"policy": { "ref": "manual-write", "required": true }
			}
		},
		"policies": {
			"manual-write": {
				"$schema": "https://schemas.flexigpt.dev/mcp/policy/v1.json",
				"kind": "mcp.policy",
				"schemaID": "mcp.policy.v1",
				"schemaVersion": "v1",
				"logicalName": "manual-write",
				"displayName": "Manual write policy",
				"body": {
					"trustLevel": "trusted",
					"defaultPolicy": {
						"defaultApprovalRule": "allow",
						"defaultExecutionMode": "manual",
						"requireApprovalForUnknownRisk": true,
						"requireApprovalForWrite": true,
						"requireApprovalForDestructive": true
					},
					"appsPolicy": {
						"enabled": false,
						"allowAppInitiatedToolCalls": false,
						"requireApprovalForOpenLink": true,
						"requireApprovalForContextUpdates": true
					}
				}
			}
		}
	}
}
