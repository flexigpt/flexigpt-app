{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flexigpt.dev/artifact/team/v1.json",
  "title": "FlexiGPT Team v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 16384},
    "apiVersion": {"type": "string", "minLength": 1, "maxLength": 256},
    "type": {"const": "team"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 16384},
    "locator": {"$ref": "#/$defs/locator"},
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "members": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/member"}
    },
    "program": {
      "$ref": "#/$defs/program"
    }
  },
  "$defs": {
    "locator": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 16384},
        {"type": "object", "required": ["kind"], "additionalProperties": true}
      ]
    },
    "member": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "instruction",
            "context",
            "model",
            "skill",
            "tool",
            "mcp",
            "mcp.policy",
            "collection",
            "agent"
          ]
        }
      },
      "additionalProperties": true
    },
    "program": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["loop", "workflow"]
        }
      },
      "additionalProperties": true
    }
  }
}
