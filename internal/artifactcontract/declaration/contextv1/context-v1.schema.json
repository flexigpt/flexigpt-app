{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flexigpt.dev/artifact/context/v1.json",
  "title": "FlexiGPT Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 16384},
    "apiVersion": {"type": "string", "minLength": 1, "maxLength": 256},
    "type": {"const": "context"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 16384},
    "locator": {"$ref": "#/$defs/locator"},
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "content": {"type": "string", "maxLength": 4194304},
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "include": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "exclude": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  },
  "$defs": {
    "locator": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 16384},
        {"type": "object", "required": ["kind"], "additionalProperties": true}
      ]
    }
  }
}
