{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.flexigpt.site/artifact/loop/v1.json",
	"title": "FlexiGPT Loop v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["type", "name"],
	"properties": {
		"$schema": { "type": "string", "minLength": 1, "maxLength": 16384 },
		"apiVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
		"type": { "const": "loop" },
		"name": { "type": "string", "minLength": 1, "maxLength": 256 },
		"description": { "type": "string", "maxLength": 16384 },
		"locator": { "$ref": "#/$defs/locator" },
		"metadata": {
			"type": "object",
			"maxProperties": 64,
			"additionalProperties": true
		},
		"body": { "$ref": "#/$defs/entry" },
		"maxIterations": {
			"type": "integer",
			"minimum": 1
		},
		"until": { "$ref": "#/$defs/outputMatch" }
	},
	"$defs": {
		"locator": {
			"oneOf": [
				{ "type": "string", "minLength": 1, "maxLength": 16384 },
				{ "type": "object", "required": ["kind"], "additionalProperties": true }
			]
		},
		"entry": {
			"type": "object",
			"required": ["type", "name"],
			"properties": {
				"type": { "type": "string" }
			},
			"additionalProperties": true
		},
		"outputMatch": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema"],
			"properties": {
				"pointer": {
					"type": "string",
					"maxLength": 16384
				},
				"schema": {
					"oneOf": [{ "type": "object" }, { "type": "boolean" }]
				}
			}
		}
	}
}
