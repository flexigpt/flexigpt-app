{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flexigpt.site/artifact/mcp.policy/v1.json",
  "title": "FlexiGPT MCP Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "name"],
  "properties": {
    "type": { "const": "mcp.policy" },
    "name": { "$ref": "#/$defs/name" },
    "displayName": { "$ref": "#/$defs/displayName" },
    "description": { "$ref": "#/$defs/description" },
    "labels": { "$ref": "#/$defs/labels" },
    "locator": { "$ref": "#/$defs/locator" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "trustLevel": {
      "enum": ["trusted", "untrusted"]
    },
    "defaultPolicy": { "$ref": "#/$defs/defaultPolicy" },
    "toolPolicies": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "$ref": "#/$defs/toolPolicy"
      }
    },
    "appsPolicy": { "$ref": "#/$defs/appsPolicy" }
  },
  "oneOf": [
    {
      "required": ["locator"],
      "not": {
        "anyOf": [
          { "required": ["trustLevel"] },
          { "required": ["defaultPolicy"] },
          { "required": ["toolPolicies"] },
          { "required": ["appsPolicy"] }
        ]
      }
    },
    {
      "not": { "required": ["locator"] }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "description": {
      "type": "string",
      "maxLength": 16384
    },
    "labels": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "maxLength": 16384
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "not": {
          "const": "flexigpt.site/mcp-runtime-v1"
        }
      },
      "additionalProperties": true
    },
    "locator": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "path" },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "url" },
            "url": {
              "type": "string",
              "format": "uri",
              "minLength": 1,
              "maxLength": 16384
            },
            "integrity": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository"],
          "properties": {
            "kind": { "const": "git" },
            "repository": {
              "type": "string",
              "format": "uri",
              "minLength": 1,
              "maxLength": 16384
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "manager", "package"],
          "properties": {
            "kind": { "const": "package" },
            "manager": {
              "enum": ["npm", "pypi", "cargo", "go", "maven", "nuget", "oci"]
            },
            "package": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "registry": {
              "type": "string",
              "format": "uri",
              "minLength": 1,
              "maxLength": 16384
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": { "const": "command" },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        }
      ]
    },
    "approvalRule": {
      "enum": ["allow", "ask", "deny"]
    },
    "executionMode": {
      "enum": ["auto", "manual"]
    },
    "defaultPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultApprovalRule": {
          "$ref": "#/$defs/approvalRule"
        },
        "defaultExecutionMode": {
          "$ref": "#/$defs/executionMode"
        },
        "requireApprovalForUnknownRisk": {
          "type": "boolean"
        },
        "requireApprovalForWrite": {
          "type": "boolean"
        },
        "requireApprovalForDestructive": {
          "type": "boolean"
        }
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvalRule": {
          "$ref": "#/$defs/approvalRule"
        },
        "executionMode": {
          "$ref": "#/$defs/executionMode"
        },
        "allowStaleDigest": {
          "type": "boolean"
        },
        "expectedDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "appsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowAppInitiatedToolCalls": {
          "type": "boolean"
        },
        "requireApprovalForOpenLink": {
          "type": "boolean"
        },
        "requireApprovalForContextUpdates": {
          "type": "boolean"
        }
      }
    }
  }
}
