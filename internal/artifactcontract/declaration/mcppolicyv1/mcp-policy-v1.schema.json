{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flexigpt.dev/artifact/mcp-policy/v1.json",
  "title": "FlexiGPT MCP Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 16384},
    "apiVersion": {"type": "string", "minLength": 1, "maxLength": 256},
    "type": {"const": "mcp.policy"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 16384},
    "locator": {"$ref": "#/$defs/locator"},
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "body": {"$ref": "#/$defs/policyBody"}
  },
  "$defs": {
    "locator": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 16384},
        {"type": "object", "required": ["kind"], "additionalProperties": true}
      ]
    },
    "approvalRule": {
      "enum": ["allow", "ask", "deny"]
    },
    "executionMode": {
      "enum": ["auto", "manual"]
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approvalRule": {"$ref": "#/$defs/approvalRule"},
        "executionMode": {"$ref": "#/$defs/executionMode"},
        "allowStaleDigest": {"type": "boolean"},
        "expectedDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "defaultPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultApprovalRule": {"$ref": "#/$defs/approvalRule"},
        "defaultExecutionMode": {"$ref": "#/$defs/executionMode"},
        "requireApprovalForUnknownRisk": {"type": "boolean"},
        "requireApprovalForWrite": {"type": "boolean"},
        "requireApprovalForDestructive": {"type": "boolean"}
      }
    },
    "appsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "allowAppInitiatedToolCalls": {"type": "boolean"},
        "requireApprovalForOpenLink": {"type": "boolean"},
        "requireApprovalForContextUpdates": {"type": "boolean"}
      }
    },
    "policyBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustLevel": {
          "enum": ["trusted", "untrusted"]
        },
        "defaultPolicy": {"$ref": "#/$defs/defaultPolicy"},
        "toolPolicies": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {"$ref": "#/$defs/toolPolicy"}
        },
        "appsPolicy": {"$ref": "#/$defs/appsPolicy"}
      }
    }
  }
}
