{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.flexigpt.site/artifact/workflow/v1.json",
	"title": "FlexiGPT Workflow v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["type", "name"],
	"properties": {
		"type": { "const": "workflow" },
		"name": { "$ref": "#/$defs/name" },
		"displayName": { "$ref": "#/$defs/displayName" },
		"description": { "$ref": "#/$defs/description" },
		"labels": { "$ref": "#/$defs/labels" },
		"locator": { "$ref": "#/$defs/locator" },
		"metadata": { "$ref": "#/$defs/metadata" },
		"start": {
			"type": "array",
			"maxItems": 4096,
			"items": { "$ref": "#/$defs/workflowID" }
		},
		"nodes": {
			"type": "array",
			"maxItems": 4096,
			"items": { "$ref": "#/$defs/node" }
		},
		"edges": {
			"type": "array",
			"maxItems": 16384,
			"items": { "$ref": "#/$defs/edge" }
		}
	},
	"$defs": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"workflowID": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"displayName": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"description": {
			"type": "string",
			"maxLength": 16384
		},
		"labels": {
			"type": "object",
			"maxProperties": 64,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"metadata": {
			"type": "object",
			"maxProperties": 64,
			"propertyNames": {
				"not": {
					"const": "flexigpt.site/mcp-runtime-v1"
				}
			},
			"additionalProperties": true
		},
		"locator": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 16384
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "path"],
					"properties": {
						"kind": { "const": "path" },
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "url"],
					"properties": {
						"kind": { "const": "url" },
						"url": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"integrity": {
							"type": "string",
							"pattern": "^sha256:[a-f0-9]{64}$"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "repository"],
					"properties": {
						"kind": { "const": "git" },
						"repository": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"revision": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "manager", "package"],
					"properties": {
						"kind": { "const": "package" },
						"manager": {
							"enum": ["npm", "pypi", "cargo", "go", "maven", "nuget", "oci"]
						},
						"package": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						},
						"version": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"registry": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "command"],
					"properties": {
						"kind": { "const": "command" },
						"command": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				}
			]
		},
		"jsonSchema": {
			"oneOf": [{ "type": "object" }, { "type": "boolean" }]
		},
		"outputMatch": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema"],
			"properties": {
				"pointer": {
					"type": "string",
					"maxLength": 16384
				},
				"schema": { "$ref": "#/$defs/jsonSchema" }
			}
		},
		"parameters": {
			"type": "object",
			"additionalProperties": true
		},
		"node": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "name"],
			"properties": {
				"id": { "$ref": "#/$defs/workflowID" },
				"join": { "enum": ["all", "any"] },
				"type": {
					"enum": [
						"text",
						"model",
						"tool",
						"skill",
						"mcp",
						"mcp.policy",
						"plugin",
						"agent",
						"team",
						"loop",
						"workflow"
					]
				},
				"name": { "$ref": "#/$defs/name" },
				"insert": {
					"enum": ["instructions", "user-message"]
				},
				"locator": { "$ref": "#/$defs/locator" },
				"scope": { "const": "builtin" },
				"server": { "$ref": "#/$defs/name" },
				"parameters": { "$ref": "#/$defs/parameters" }
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"type": { "const": "text" }
						}
					},
					"then": { "required": ["insert"] },
					"else": { "not": { "required": ["insert"] } }
				},
				{
					"if": {
						"properties": {
							"type": { "const": "mcp" }
						}
					},
					"then": {
						"dependentRequired": {
							"server": ["locator"]
						}
					},
					"else": { "not": { "required": ["server"] } }
				},
				{
					"if": { "required": ["parameters"] },
					"then": {
						"not": {
							"anyOf": [{ "required": ["scope"] }, { "required": ["server"] }]
						}
					},
					"else": {
						"not": { "required": ["scope", "locator"] }
					}
				}
			]
		},
		"edge": {
			"type": "object",
			"additionalProperties": false,
			"required": ["from", "to"],
			"properties": {
				"from": { "$ref": "#/$defs/workflowID" },
				"to": { "$ref": "#/$defs/workflowID" },
				"match": { "$ref": "#/$defs/outputMatch" }
			}
		}
	}
}
