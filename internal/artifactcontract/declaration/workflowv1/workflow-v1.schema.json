{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.flexigpt.site/artifact/workflow/v1.json",
	"title": "FlexiGPT Workflow v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["type", "name"],
	"properties": {
		"$schema": { "type": "string", "minLength": 1, "maxLength": 16384 },
		"apiVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
		"type": { "const": "workflow" },
		"name": { "type": "string", "minLength": 1, "maxLength": 256 },
		"description": { "type": "string", "maxLength": 16384 },
		"locator": { "$ref": "#/$defs/locator" },
		"metadata": {
			"type": "object",
			"maxProperties": 64,
			"additionalProperties": true
		},
		"start": {
			"type": "array",
			"maxItems": 4096,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 256
			}
		},
		"nodes": {
			"type": "array",
			"maxItems": 4096,
			"items": { "$ref": "#/$defs/node" }
		},
		"edges": {
			"type": "array",
			"maxItems": 16384,
			"items": { "$ref": "#/$defs/edge" }
		}
	},
	"$defs": {
		"locator": {
			"oneOf": [
				{ "type": "string", "minLength": 1, "maxLength": 16384 },
				{ "type": "object", "required": ["kind"], "additionalProperties": true }
			]
		},
		"entry": {
			"type": "object",
			"required": ["type", "name"],
			"properties": {
				"type": { "type": "string" }
			},
			"additionalProperties": true
		},
		"outputMatch": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema"],
			"properties": {
				"pointer": { "type": "string", "maxLength": 16384 },
				"schema": {
					"oneOf": [{ "type": "object" }, { "type": "boolean" }]
				}
			}
		},
		"node": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "target"],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"target": { "$ref": "#/$defs/entry" },
				"join": {
					"enum": ["all", "any"]
				}
			}
		},
		"edge": {
			"type": "object",
			"additionalProperties": false,
			"required": ["from", "to"],
			"properties": {
				"from": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"to": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"match": { "$ref": "#/$defs/outputMatch" }
			}
		}
	}
}
