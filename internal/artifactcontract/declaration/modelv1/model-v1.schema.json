{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flexigpt.dev/artifact/model/v1.json",
  "title": "FlexiGPT Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 16384},
    "apiVersion": {"type": "string", "minLength": 1, "maxLength": 256},
    "type": {"const": "model"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 16384},
    "locator": {"$ref": "#/$defs/locator"},
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "parameters": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": true
    }
  },
  "$defs": {
    "locator": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 16384},
        {"type": "object", "required": ["kind"], "additionalProperties": true}
      ]
    }
  }
}
