{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.flexigpt.site/artifact/model/v1.json",
	"title": "FlexiGPT Model v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["type", "name", "model"],
	"properties": {
		"type": { "const": "model" },
		"name": { "$ref": "#/$defs/name" },
		"displayName": { "$ref": "#/$defs/displayName" },
		"description": { "$ref": "#/$defs/description" },
		"labels": { "$ref": "#/$defs/labels" },
		"locator": { "$ref": "#/$defs/locator" },
		"metadata": { "$ref": "#/$defs/metadata" },
		"model": {
			"type": "string",
			"minLength": 1,
			"maxLength": 16384
		},
		"systemPrompt": {
			"type": "string",
			"maxLength": 4194304
		},
		"temperature": {
			"type": "number",
			"minimum": 0,
			"maximum": 2
		},
		"maxOutputTokens": {
			"type": "integer",
			"minimum": 1
		}
	},
	"$defs": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"displayName": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"description": {
			"type": "string",
			"maxLength": 16384
		},
		"labels": {
			"type": "object",
			"maxProperties": 64,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"metadata": {
			"type": "object",
			"maxProperties": 64,
			"propertyNames": {
				"not": {
					"const": "flexigpt.site/mcp-runtime-v1"
				}
			},
			"additionalProperties": true
		},
		"locator": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 16384
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "path"],
					"properties": {
						"kind": { "const": "path" },
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "url"],
					"properties": {
						"kind": { "const": "url" },
						"url": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"integrity": {
							"type": "string",
							"pattern": "^sha256:[a-f0-9]{64}$"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "repository"],
					"properties": {
						"kind": { "const": "git" },
						"repository": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"revision": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "manager", "package"],
					"properties": {
						"kind": { "const": "package" },
						"manager": {
							"enum": ["npm", "pypi", "cargo", "go", "maven", "nuget", "oci"]
						},
						"package": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						},
						"version": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"registry": {
							"type": "string",
							"format": "uri",
							"minLength": 1,
							"maxLength": 16384
						},
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "command"],
					"properties": {
						"kind": { "const": "command" },
						"command": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				}
			]
		}
	}
}
