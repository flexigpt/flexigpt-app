{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flexigpt.dev/artifact/instruction/v1.json",
  "title": "FlexiGPT Instruction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "type": {
      "const": "instruction"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 16384
    },
    "locator": {
      "$ref": "#/$defs/locator"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "content": {
      "type": "string",
      "maxLength": 4194304
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "$defs": {
    "locator": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 16384},
        {"type": "object", "required": ["kind"], "additionalProperties": true}
      ]
    }
  }
}
