{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flexigpt.dev/artifact/collection/v1.json",
  "title": "FlexiGPT Collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 16384},
    "apiVersion": {"type": "string", "minLength": 1, "maxLength": 256},
    "type": {"const": "collection"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 16384},
    "locator": {"$ref": "#/$defs/locator"},
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "members": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "locator": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 16384},
        {"type": "object", "required": ["kind"], "additionalProperties": true}
      ]
    },
    "entry": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "name": {"type": "string"},
        "locator": {"$ref": "#/$defs/locator"}
      },
      "additionalProperties": true
    }
  }
}
