{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flexigpt.dev/artifact/skill/v1.json",
  "title": "FlexiGPT Skill v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 16384},
    "apiVersion": {"type": "string", "minLength": 1, "maxLength": 256},
    "type": {"const": "skill"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 16384},
    "locator": {"$ref": "#/$defs/locator"},
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "allowedTools": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/toolEntry"
      }
    }
  },
  "$defs": {
    "locator": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 16384},
        {"type": "object", "required": ["kind"], "additionalProperties": true}
      ]
    },
    "toolEntry": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"const": "tool"},
        "name": {"type": "string"},
        "locator": {"$ref": "#/$defs/locator"}
      },
      "additionalProperties": true
    }
  }
}
