{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.flexigpt.site/artifact/tool/v1.json",
	"title": "FlexiGPT Tool v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"type",
		"name",
		"userCallable",
		"llmCallable",
		"autoExecute",
		"llmToolType",
		"inputSchema",
		"implementation"
	],
	"properties": {
		"type": { "const": "tool" },
		"name": { "$ref": "#/$defs/name" },
		"displayName": { "$ref": "#/$defs/displayName" },
		"description": { "$ref": "#/$defs/description" },
		"labels": { "$ref": "#/$defs/labels" },
		"metadata": { "$ref": "#/$defs/metadata" },
		"userCallable": { "type": "boolean" },
		"llmCallable": { "type": "boolean" },
		"autoExecute": { "type": "boolean" },
		"llmToolType": { "const": "function" },
		"inputSchema": { "$ref": "#/$defs/jsonSchema" },
		"userArgSchema": { "$ref": "#/$defs/jsonSchema" },
		"outputSchema": { "$ref": "#/$defs/jsonSchema" },
		"implementation": { "$ref": "#/$defs/implementation" }
	},
	"$defs": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"displayName": {
			"type": "string",
			"minLength": 1,
			"maxLength": 1024
		},
		"description": {
			"type": "string",
			"maxLength": 16384
		},
		"labels": {
			"type": "object",
			"maxProperties": 64,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"metadata": {
			"type": "object",
			"maxProperties": 64,
			"propertyNames": {
				"not": {
					"const": "flexigpt.site/mcp-runtime-v1"
				}
			},
			"additionalProperties": true
		},
		"jsonSchema": {
			"oneOf": [{ "type": "object" }, { "type": "boolean" }]
		},
		"stringMap": {
			"type": "object",
			"maxProperties": 4096,
			"additionalProperties": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"stringArray": {
			"type": "array",
			"maxItems": 4096,
			"items": {
				"type": "string",
				"maxLength": 16384
			}
		},
		"implementation": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "function"],
					"properties": {
						"kind": { "const": "go" },
						"function": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "request", "response"],
					"properties": {
						"kind": { "const": "http" },
						"request": {
							"type": "object",
							"additionalProperties": false,
							"required": ["method", "urlTemplate"],
							"properties": {
								"method": {
									"type": "string",
									"minLength": 1,
									"maxLength": 32
								},
								"urlTemplate": {
									"type": "string",
									"minLength": 1,
									"maxLength": 16384
								},
								"headers": { "$ref": "#/$defs/stringMap" },
								"bodyTemplate": {
									"type": "string",
									"maxLength": 4194304
								}
							}
						},
						"response": {
							"type": "object",
							"additionalProperties": false,
							"required": ["successCodes", "bodyOutputMode"],
							"properties": {
								"successCodes": {
									"type": "array",
									"minItems": 1,
									"maxItems": 128,
									"items": {
										"type": "integer",
										"minimum": 100,
										"maximum": 599
									}
								},
								"bodyOutputMode": {
									"enum": ["json", "text", "bytes"]
								}
							}
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "provider", "operation"],
					"properties": {
						"kind": { "const": "sdk" },
						"provider": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						},
						"operation": {
							"type": "string",
							"minLength": 1,
							"maxLength": 256
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "command"],
					"properties": {
						"kind": { "const": "command" },
						"command": {
							"type": "string",
							"minLength": 1,
							"maxLength": 16384
						},
						"args": { "$ref": "#/$defs/stringArray" },
						"env": { "$ref": "#/$defs/stringMap" }
					}
				}
			]
		}
	}
}
